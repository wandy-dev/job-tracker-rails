<div class="mb-4">
  <%= link_to "&larr; Back to Jobs".html_safe, jobs_path, class: "has-text-grey" %>
</div>

<div class="box is-flex is-align-items-center is-flex-wrap-wrap mb-6 has-background-light p-3">
  <div class="is-flex is-align-items-center is-flex-wrap-wrap" style="gap: 10px;">
    <% Job::HAPPY_PATH_STATUSES.each_with_index do |step, index| %>
      <div class="<%= chevron_step_class(@job, index) %>">
        <%= step.titleize %>
      </div>
      <% if index < Job::HAPPY_PATH_STATUSES.length - 1 %>
        <div class="has-text-grey-light">></div>
      <% end %>
    <% end %>
  </div>

  <div class="buttons is-marginless ml-auto">
    <% if can_advance_job?(@job) %>
      <%= button_to "Mark Stage as Complete", job_status_advancement_path(@job), method: :post, class: "button is-link is-small" %>
    <% end %>
    <% if show_terminal_buttons?(@job) %>
      <%= button_to "Reject", job_rejection_path(@job), method: :post, form: { data: { turbo_confirm: "Are you sure?" } }, class: "button is-danger is-small is-light" %>
      <%= button_to "Ghosted", job_ghosting_path(@job), method: :post, form: { data: { turbo_confirm: "Are you sure?" } }, class: "button is-light is-small" %>
      <%= button_to "Withdraw", job_withdrawal_path(@job), method: :post, form: { data: { turbo_confirm: "Are you sure?" } }, class: "button is-warning is-small is-light" %>
    <% end %>
  </div>
</div>

<div class="columns is-multiline">
  <div class="column is-8-desktop">
    <div class="content mb-6">
      <h1 class="title is-2 mb-2"><%= @job.title %></h1>
      <h2 class="subtitle is-4 has-text-grey mt-2">
        at <%= link_to @job.company.name, company_path(@job.company), class: "has-text-link" %>
      </h2>
    </div>

    <!-- Job Details Row -->
    <div class="box mb-6 p-4">
      <div class="columns is-mobile is-multiline mb-0">
        <div class="column is-half-mobile is-one-third-tablet pb-0">
          <p class="heading has-text-grey mb-1">Status</p>
          <p class="title is-6"><%= @job.status.titleize %></p>
        </div>
        <div class="column is-half-mobile is-one-third-tablet pb-0">
          <p class="heading has-text-grey mb-1">Location</p>
          <p class="title is-6"><%= @job.location.presence || "Unknown" %></p>
        </div>
        <div class="column is-half-mobile is-one-third-tablet pb-0">
          <p class="heading has-text-grey mb-1">Added On</p>
          <p class="title is-6"><%= @job.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>
      <% if @job.url.present? %>
        <div class="mt-4 pt-3" style="border-top: 1px solid #f5f5f5;">
          <%= link_to "View Original Posting &rarr;".html_safe, @job.url, target: "_blank", class: "button is-small is-link is-light" %>
        </div>
      <% end %>
    </div>

    <h3 class="title is-4 mb-4">Activity Timeline</h3>
    <turbo-frame id="new_activity">
      <div class="mb-5">
        <%= link_to "Log Activity", new_job_activity_path(@job), class: "button is-link is-outlined" %>
      </div>
    </turbo-frame>

    <div id="activities_feed">
      <% if @activities.any? %>
        <%= render @activities %>
      <% else %>
        <div class="notification is-light has-text-centered has-text-grey p-5">
          <p class="is-italic">No activities logged yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="column is-4-desktop">
    <div class="box has-background-light">
      <h3 class="title is-5 mb-4">Company Contacts</h3>
      <% if @job.company.contacts.any? %>
        <div class="is-flex is-flex-direction-column">
          <% @job.company.contacts.order(:name).each do |contact| %>
            <div class="box p-3 mb-3 shadow-sm">
              <h5 class="title is-6 mb-1"><%= contact.name %></h5>
              <% if contact.title.present? %>
                <div class="subtitle is-7 has-text-grey is-italic mb-2"><%= contact.title %></div>
              <% end %>
              <% if contact.email.present? %>
                <div class="is-size-7 mb-1">
                  <strong class="has-text-grey">Email:</strong> <%= mail_to contact.email, contact.email %>
                </div>
              <% end %>
              <% if contact.phone.present? %>
                <div class="is-size-7">
                  <strong class="has-text-grey">Phone:</strong> <%= link_to contact.phone, "tel:#{contact.phone}" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="has-text-grey is-size-7 mb-4">No contacts added yet.</p>
        <%= link_to "Add contact", company_path(@job.company), class: "button is-small is-white w-100" %>
      <% end %>
    </div>

    <div class="mt-6 has-text-right">
      <%= button_to "Delete Job", job_path(@job), method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to delete this job? This action cannot be undone.' } }, class: "button is-danger is-small is-light" %>
    </div>
  </div>
</div>
