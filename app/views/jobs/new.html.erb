<h1>Track a New Job</h1>

<%= form_with url: jobs_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :url, "Job Posting URL" %><br>
    <%= form.text_field :url, placeholder: "https://boards.greenhouse.io/...", required: true, size: 80 %>
  </div>
  
  <div class="mt-3">
    <%= form.submit "Parse and Add Job" %>
  </div>
<% end %>

<br>
<%= link_to "Back to Jobs", jobs_path %>
