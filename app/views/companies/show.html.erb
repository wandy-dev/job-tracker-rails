<h1><%= @company.name %></h1>

<% if @company.url.present? %>
  <p><%= link_to "Company Website", @company.url, target: "_blank" %></p>
<% end %>

<% if @company.notes.present? %>
  <div>
    <strong>Notes:</strong>
    <p><%= @company.notes %></p>
  </div>
<% end %>

<hr>
<h3>Jobs at <%= @company.name %></h3>

<% if @jobs.any? %>
  <ul>
    <% @jobs.each do |job| %>
      <li>
        <%= link_to job.title, job_path(job) %> - <em><%= job.status.titleize %></em>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No jobs tracked yet.</p>
<% end %>

<hr>
<h3>Contacts at <%= @company.name %></h3>

<turbo-frame id="new_contact">
  <div style="margin-bottom: 20px;">
    <%= link_to "Add Contact", new_company_contact_path(@company), class: "btn btn-advance" %>
  </div>
</turbo-frame>

<div id="contacts_feed" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px;">
  <% if @contacts.any? %>
    <%= render @contacts %>
  <% else %>
    <p style="grid-column: 1 / -1;">No contacts added yet.</p>
  <% end %>
</div>

<br>
<%= link_to "Back to Companies", companies_path %> | 
<%= link_to "Back to Jobs", jobs_path %> |
<%= button_to "Delete Company", company_path(@company), method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to delete this company and all of its jobs?' } }, style: "color: red; background: none; border: none; cursor: pointer; display: inline;" %>
