<div class="mb-4">
  <%= link_to "&larr; Back to Companies".html_safe, companies_path, class: "has-text-grey" %>
</div>

<div class="columns is-multiline">
  <div class="column is-8-desktop">
    <div class="content mb-6">
      <h1 class="title is-2 mb-2"><%= @company.name %></h1>
      <% if @company.url.present? %>
        <p class="mt-2">
          <%= link_to "Visit Company Website &rarr;".html_safe, @company.url, target: "_blank", class: "has-text-link" %>
        </p>
      <% end %>
    </div>

    <% if @company.notes.present? %>
      <div class="box has-background-light mb-6 p-4">
        <h4 class="title is-6 has-text-grey mb-2">Notes</h4>
        <div class="content">
          <%= simple_format @company.notes %>
        </div>
      </div>
    <% end %>

    <div class="mb-6">
      <h3 class="title is-4 mb-4">Jobs at <%= @company.name %></h3>
      <% if @jobs.any? %>
        <div class="is-flex is-flex-direction-column">
          <% @jobs.each do |job| %>
            <div class="box p-4 mb-3 is-flex is-justify-content-space-between is-align-items-center">
              <div>
                <h4 class="title is-5 mb-1"><%= link_to job.title, job_path(job), class: "has-text-dark" %></h4>
                <p class="subtitle is-7 has-text-grey mb-0">Added <%= job.created_at.strftime("%b %d, %Y") %></p>
              </div>
              <div>
                <span class="tag <%= job.status == 'offered' ? 'is-success' : 'is-light' %> is-medium">
                  <%= job.status.titleize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="notification is-light has-text-centered has-text-grey p-5">
          <p class="is-italic">No jobs tracked yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="column is-4-desktop">
    <div class="box has-background-light">
      <h3 class="title is-5 mb-4">Contacts at <%= @company.name %></h3>
      
      <turbo-frame id="new_contact">
        <div class="mb-4">
          <%= link_to "Add Contact", new_company_contact_path(@company), class: "button is-link is-outlined is-fullwidth" %>
        </div>
      </turbo-frame>

      <div id="contacts_feed">
        <% if @contacts.any? %>
          <%= render @contacts %>
        <% else %>
          <div class="has-text-centered p-4">
            <p class="has-text-grey is-size-7">No contacts added yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-6 has-text-right">
      <%= button_to "Delete Company", company_path(@company), method: :delete, form: { data: { turbo_confirm: 'Are you sure you want to delete this company and ALL of its jobs? This action cannot be undone.' } }, class: "button is-danger is-small is-light" %>
    </div>
  </div>
</div>
