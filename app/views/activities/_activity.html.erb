<div id="<%= dom_id(activity) %>" class="box pl-4 mb-5" style="border-left: 4px solid #485fc7; border-radius: 0 4px 4px 0;">
  <div class="is-flex is-justify-content-space-between is-align-items-baseline mb-2">
    <strong><%= activity.action_type.titleize %></strong>
    <span class="has-text-grey is-size-7"><%= activity.occurred_at&.strftime("%B %d, %Y %I:%M %p") %></span>
  </div>
  <% if activity.notes.present? %>
    <p class="has-text-dark"><%= activity.notes %></p>
  <% end %>
  <div class="mt-2">
    <%= button_to "Delete", job_activity_path(activity.job, activity), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "button is-danger", style: "font-size: 12px; padding: 2px 6px;" %>
  </div>
</div>
