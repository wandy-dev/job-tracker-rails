<%= turbo_frame_tag "new_activity" do %>
  <div class="activity-form-container" class="box has-background-light mb-5">
    <%= form_with(model: [@job, @activity], class: "activity-form") do |f| %>
      <div class="columns is-mobile mb-2">
        <div class="column">
          <%= f.label :action_type, "Type", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.select :action_type, Activity.action_types.keys.map { |type| [type.titleize, type] }, {}, style: "width: 100%; padding: 6px;" %>
        </div>
        <div class="column">
          <%= f.label :occurred_at, "Date & Time", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.datetime_local_field :occurred_at, style: "width: 100%; padding: 6px;" %>
        </div>
      </div>
      
      <div class="field mb-3">
        <%= f.label :notes, "Notes", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
        <%= f.text_area :notes, rows: 2, placeholder: "Add notes...", style: "width: 100%; padding: 6px;" %>
      </div>
      
      <div class="buttons">
        <%= f.submit "Log Activity", class: "button is-link" %>
        <%= link_to "Cancel", job_path(@job), class: "button" %>
      </div>
    <% end %>
  </div>
<% end %>
