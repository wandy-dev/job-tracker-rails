<%= turbo_frame_tag "new_contact" do %>
  <div class="box has-background-light mb-5">
    <%= form_with(model: [@company, @contact]) do |f| %>
      <div class="columns is-mobile mb-2">
        <div class="column">
          <%= f.label :name, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.text_field :name, required: true, style: "width: 100%; padding: 6px;" %>
        </div>
        <div class="column">
          <%= f.label :title, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.text_field :title, style: "width: 100%; padding: 6px;" %>
        </div>
      </div>
      
      <div class="columns is-mobile mb-2">
        <div class="column">
          <%= f.label :email, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.email_field :email, style: "width: 100%; padding: 6px;" %>
        </div>
        <div class="column">
          <%= f.label :phone, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
          <%= f.telephone_field :phone, style: "width: 100%; padding: 6px;" %>
        </div>
      </div>
      
      <div class="field mb-3">
        <%= f.label :notes, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
        <%= f.text_area :notes, rows: 2, style: "width: 100%; padding: 6px;" %>
      </div>
      
      <div class="buttons">
        <%= f.submit "Add Contact", class: "button is-link" %>
        <%= link_to "Cancel", company_path(@company), class: "button" %>
      </div>
    <% end %>
  </div>
<% end %>
