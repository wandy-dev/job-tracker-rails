<div id="<%= dom_id(contact) %>" class="box mb-4">
  <div class="is-flex is-justify-content-space-between is-align-items-flex-start">
    <div>
      <h4 class="title is-5 mb-1"><%= contact.name %></h4>
      <% if contact.title.present? %>
        <div class="subtitle is-6 has-text-grey is-italic mb-3"><%= contact.title %></div>
      <% end %>
      
      <% if contact.email.present? %>
        <div class="mb-2">
          <strong>Email:</strong> <%= mail_to contact.email, contact.email %>
        </div>
      <% end %>
      
      <% if contact.phone.present? %>
        <div class="mb-2">
          <strong>Phone:</strong> <%= link_to contact.phone, "tel:#{contact.phone}" %>
        </div>
      <% end %>
      
      <% if contact.notes.present? %>
        <div class="mt-3 pt-3" style="border-top: 1px solid #ededed;">
          <strong class="is-block mb-1 has-text-weight-bold">Notes:</strong>
          <%= contact.notes %>
        </div>
      <% end %>
    </div>
    
    <div>
      <%= button_to "Delete", company_contact_path(contact.company, contact), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "button is-danger is-small is-light" %>
    </div>
  </div>
</div>
